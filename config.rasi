configuration {
    modi:                       "drun,run,filebrowser";
    show-icons:                 true;
    display-drun:               " ";
    drun-display-format:        "{name}";
    font:                       "JetBrainsMono Nerd Font 10";
}

* {
    bg:                         #1a1b26;
    bg-selected:                #24283b;
    fg:                         #c0caf5;
    accent:                     #7aa2f7;
    border-col:                 #7aa2f7;
    
    background-color:           transparent;
    text-color:                 @fg;
}

window {
    transparency:               "real";
    location:                   north west;
    anchor:                     north west;
    x-offset:                   10px;
    y-offset:                   44px;
    width:                      320px;
    border:                     2px;
    border-color:               @border-col;
    border-radius:              16px;
    background-color:           rgba(26, 27, 38, 0.95);
    children:                   [ inputbar, listview ];
}

inputbar {
    enabled:                    true;
    padding:                    12px;
    background-color:           transparent;
    children:                   [ entry ];
}

entry {
    background-color:           @bg-selected;
    text-color:                 @fg;
    placeholder:                "Suchen...";
    placeholder-color:          #565f89;
    padding:                    8px 12px;
    border-radius:              10px;
}

listview {
    enabled:                    true;
    columns:                    1;
    lines:                      8;
    cycle:                      true;
    dynamic:                    true;
    scrollbar:                  false;
    layout:                     vertical;
    reverse:                    false;
    padding:                    6px 12px 12px 12px;
    spacing:                    4px;
}

element {
    enabled:                    true;
    padding:                    8px 10px;
    border-radius:              10px;
    background-color:           transparent;
    text-color:                 @fg;
    cursor:                     pointer;
}

element selected {
    background-color:           rgba(122, 162, 247, 0.2);
    text-color:                 @accent;
    border:                     1px;
    border-color:               @accent;
}

element-icon {
    size:                       24px;
    margin:                     0 10px 0 0;
}

element-text {
    vertical-align:             0.5;
    text-color:                 inherit;
}
